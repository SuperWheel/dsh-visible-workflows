import test from 'node:test'
import assert from 'node:assert/strict'
import {savedCandidateCheck,checkCase} from '../../scripts/probes/verify-planning-speed-accepted.mts'
import {renumberWorkflow} from '../../src/shared/numbering.ts'
import {SCOPE} from '../../scripts/probes/collect-planning-speed-desktop.mjs'
const budget={budgetDecision:{mode:'unlimited' as const,decidedAt:'2026-10-19T13:50:00.000Z'},executionPolicy:{}}
function candidate():any{return {id:'synthetic-flow',workspaceId:SCOPE.workspaceId,title:'S10 test',description:'',revision:1,createdAt:'created',updatedAt:'before',notes:[],nodes:[{id:'start',kind:'input',title:'Input',number:'a-1',x:0,y:0,fixed:false,config:{fields:[]}},{id:'out',kind:'output',title:'Output',number:'a-2',x:500,y:0,fixed:false,config:{text:'{{code.text}}',outputName:'result'}},{id:'code',kind:'code',title:'Code',number:'a-3',x:250,y:0,fixed:false,config:{code:'fixed',inputs:{specification:{title:'frozen'}},outputSchema:[]}}],edges:[{id:'e1',source:'start',target:'code'},{id:'e2',source:'code',target:'out'}]}}
function saved(){return {...renumberWorkflow(candidate()),...structuredClone(budget),revision:2,updatedAt:'saved'}}
test('saved comparison permits exact frozen human budget plus production numbering/revision/time only',()=>{const base=candidate(),after=saved();assert(savedCandidateCheck(base,after,budget,2).passed);for(const mutate of [(f:any)=>f.nodes[1].x++,(f:any)=>f.nodes[1].number='made-up',(f:any)=>f.budgetDecision.decidedAt='changed',(f:any)=>f.nodes[2].config.inputs.specification.title='changed',(f:any)=>f.editor={viewport:{x:1}}]){const changed=structuredClone(after);mutate(changed);assert(!savedCandidateCheck(base,changed,budget,2).passed)}assert(!savedCandidateCheck(base,{...after,revision:3},budget,2).passed)})
test('module creation timestamp requires the exact separately recorded storage timestamp',()=>{const base=candidate(),after={...saved(),createdAt:'actual-created',revision:1};assert(!savedCandidateCheck(base,after,budget,1).passed);assert(savedCandidateCheck(base,after,budget,1,{createdAt:'actual-created'}).passed);assert(!savedCandidateCheck(base,{...after,createdAt:'other'},budget,1,{createdAt:'actual-created'}).passed)})
test('runtime oracle excludes old revisions and requires actual graph, output and zero-ledger proof',()=>{const flow=saved(),run={id:'r',workflowId:flow.id,workspaceId:SCOPE.workspaceId,sourceRevision:2,status:'success',engine:{name:'graphon'},inputs:{text:'甲'},outputs:{result:'expected'},graph:structuredClone(flow),executions:[],budget:{calls:0,agentTasks:0,unknownCalls:0,spentTokens:0}};assert(checkCase([run],flow,{text:'甲'},'expected',2).passed);assert(!checkCase([{...run,sourceRevision:1}],flow,{text:'甲'},'expected',2).passed);assert(!checkCase([{...run,budget:undefined}],flow,{text:'甲'},'expected',2).passed);const changed=structuredClone(run);changed.graph.nodes[2].config.code='bad';assert(!checkCase([changed],flow,{text:'甲'},'expected',2).passed)})
test('module JSON inputs allow whitespace only and require scalar count contract; waiting samples remain not observed',()=>{const flow=saved(),run={id:'r',workflowId:flow.id,workspaceId:SCOPE.workspaceId,sourceRevision:1,status:'success',engine:{name:'graphon'},inputs:{rows:'[ ]'},outputs:{result:'empty'},graph:structuredClone(flow),executions:[{nodeId:'code',data:{count:0}}],budget:{calls:0,agentTasks:0,unknownCalls:0,spentTokens:0}};assert(checkCase([run],flow,{rows:'[]'},'empty',1,0).passed);assert(!checkCase([{...run,inputs:{}}],flow,{rows:'[]'},'empty',1,0).passed);assert(!checkCase([{...run,executions:[]}],flow,{rows:'[]'},'empty',1,0).passed)})
