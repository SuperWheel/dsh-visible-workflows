#!/usr/bin/env node
// Synthetic native event shapes from cliworker-now/native-agy.mjs; no network/provider.
import { appendFileSync, existsSync, readFileSync, readdirSync, writeFileSync } from 'node:fs';
import { basename, join } from 'node:path';
const args = process.argv.slice(2);
if (args.includes('--version')) { console.log('1.4.5'); process.exit(0); }
const plan = JSON.parse(readFileSync(process.env.FAKE_AGY_PLAN, 'utf8'));
const state = join(process.cwd(), 'fixture-turn');
const turn = existsSync(state) ? Number(readFileSync(state, 'utf8')) : 0;
appendFileSync(process.env.FAKE_AGY_LOG, JSON.stringify({ args, cwd: process.cwd(), entries: readdirSync(process.cwd()), turn }) + '\n');
writeFileSync(state, String(turn + 1));
const conversation = `fake-${basename(process.cwd())}`;
const send = value => console.log(JSON.stringify(value));
const usage = { input_tokens: 10, output_tokens: 5, cache_read_tokens: 2, total_tokens: 15 };
if (plan.scenario === 'timeout') { setInterval(() => {}, 1000); }
else {
  send({ event: 'init', conversation_id: conversation, init: { model: args[args.indexOf('--model') + 1] } });
  if (plan.scenario === 'tool') send({ event: 'step_update', step_update: { step_index: 0, step_type: 'tool', state: 'RUNNING', tool_name: 'run_command', tool_info: { name: 'run_command' } } });
  if (plan.scenario === 'permission') send({ event: 'permission_request', permission_request: { tool_name: 'read_file' } });
  if (plan.scenario === 'stderr-permission') process.stderr.write('Permission request: approve tool read_file?\n');
  if (plan.scenario === 'unknown-event') send({ event: 'new_tool_protocol' });
  if (plan.scenario === 'wrong-model') send({ event: 'init', conversation_id: conversation, init: { model: 'different' } });
  if (plan.scenario === 'wrong-conversation') send({ event: 'step_update', step_update: { conversation_id: 'another', step_index: 0, step_type: 'agent_response', state: 'RUNNING', text_delta: '' } });
  if (plan.scenario === 'malformed') process.stdout.write('not-json\n');
  const response = plan.outputs?.[turn] ?? { submission: { mode: 'create' } };
  send({ event: 'step_update', step_update: { step_index: 1, step_type: 'agent_response', state: 'RUNNING', text_delta: '{' } });
  send({ event: 'step_update', step_update: { step_index: 1, step_type: 'agent_response', state: 'DONE', text_delta: '', ...(plan.scenario === 'missing-usage' ? {} : { usage }) } });
  // Real 1.4.5 shape: --json-schema output arrives via agy's own finish tool, which may be rejected and retried.
  if (plan.scenario === 'finish') for (const state of ['ACTIVE', 'ERROR', 'ACTIVE', 'DONE']) send({ event: 'step_update', step_update: { step_index: 2, step_type: 'tool', state, tool_name: 'finish', tool_info: { name: 'finish', parameters: response } } });
  send({ event: 'result', result: { conversation_id: conversation, status: 'SUCCESS', response: JSON.stringify(response),
    ...(plan.scenario === 'structured' ? { structured_output: response } : {}),
    ...(plan.scenario === 'final-usage' ? { usage } : {}) } });
}
