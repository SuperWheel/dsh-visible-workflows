<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22000.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>WorkflowSecretBroker</AssemblyName>
    <RootNamespace>WorkflowSecretBroker</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <WindowsAcceptanceBuild Condition="'$(WindowsAcceptanceBuild)' == ''">false</WindowsAcceptanceBuild>
    <DefineConstants Condition="'$(WindowsAcceptanceBuild)' == 'true'">$(DefineConstants);WINDOWS_ACCEPTANCE_BUILD</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Sources/**/*.cs" />
  </ItemGroup>
</Project>
