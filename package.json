{
  "name": "dsh-visible-dynamic-workflows",
  "version": "0.0.3",
  "private": true,
  "description": "DeepSeek Harness 可视化工作流 MVP",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./compiler": {
      "types": "./lib/types/shared/workflow-compiler.d.ts",
      "default": "./lib/compiler.js"
    }
  },
  "files": [
    "lib",
    "!lib/*.tsbuildinfo",
    "cordis.patch.yml",
    "README.md",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "runtime/graphon_bridge/*.py",
    "runtime/graphon_bridge/README.md",
    "runtime-assets/*",
    "runtime/packaging/THIRD_PARTY_NOTICES.md",
    "runtime/packaging/licenses/*",
    "runtime/packaging/runtime-lock.json",
    "runtime/packaging/README.md",
    "LICENSE",
    "native/os-secret-broker/dist",
    "native/os-secret-broker/README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.host-build.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "prepack": "node scripts/build.mjs",
    "preview": "tsx scripts/preview-server.ts",
    "build:runtime": "python3 scripts/build-graphon-runtime.py --platform macos-arm64",
    "build:os-secret-broker": "node native/os-secret-broker/build.mjs",
    "workflow:compile": "node --import tsx scripts/workflow-compile.ts",
    "storage:diagnose": "node --import tsx scripts/storage-diagnose.ts",
    "bench:compiler": "node --import tsx scripts/benchmarks/workflow-compiler.ts",
    "bench:template-paired": "node --import tsx scripts/benchmarks/template-fill-paired-cli.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-api-gateway": "*",
    "@deepseek-ai/dsh-api-remotes": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-store": "*",
    "@deepseek-ai/dsh-client-ui-conversation": "*",
    "@deepseek-ai/dsh-client-ui-input-trigger": "*",
    "@deepseek-ai/dsh-client-ui-layout": "*",
    "@deepseek-ai/dsh-client-ui-sidebar": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/dsh-client-ui-renderer": "*",
    "@deepseek-ai/dsh-client-ui-session": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-client-ui-theme": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-session-query": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-typert-protocol": "*",
    "@deepseek-ai/dsh-typert-registry": "*",
    "@deepseek-ai/dsh-workspace": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-plan-mode": "*",
    "@deepseek-ai/dsh-sandbox-policy": "*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/dsh-api-workspace-controller": "*",
    "@deepseek-ai/dsh-api-session-controller": "*",
    "@deepseek-ai/dsh-client-ui-workspace": "*",
    "@deepseek-ai/dsh-sandbox": "*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "zod": "4.4.3",
    "quickjs-emscripten": "0.32.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.1",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.1-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.1",
    "@deepseek-ai/dsh-plan-mode": "0.2.1-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.1",
    "@deepseek-ai/dsh-session": "0.2.1-rc.1",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.1",
    "@deepseek-ai/dsh-typert-generator": "0.2.1-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.1",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.1",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.1",
    "@types/node": "22.18.6",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "react": "^18.2.0",
    "react-dom": "18.3.1",
    "tsdown": "0.22.2",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.8",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.1-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.1",
    "vite": "8.3.2",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.1",
    "@shikijs/langs": "^4.3.1",
    "anser": "^2.3.5",
    "clsx": "^2.0.0",
    "css-select": "7.0.0",
    "diff": "^9.0.0",
    "htmlparser2": "12.0.0",
    "immer": "^10.1.1",
    "katex": "^0.16.47",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.2",
    "shiki": "^4.3.1",
    "simple-icons": "16.31.0",
    "zustand": "^4.4.7",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.1",
    "react-test-renderer": "18.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuperWheel/dsh-visible-workflows.git"
  },
  "homepage": "https://github.com/SuperWheel/dsh-visible-workflows#readme",
  "bugs": {
    "url": "https://github.com/SuperWheel/dsh-visible-workflows/issues"
  },
  "packageManager": "pnpm@11.25.0",
  "bin": {
    "workflow-compile": "./lib/workflow-compile.js"
  }
}
